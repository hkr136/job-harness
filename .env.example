# Legacy one-provider settings (still supported). Prefer selecting providers in
# ~/.job-harness/config.yaml; provider-specific secrets remain here.
JOB_AGENT_LLM_API_KEY=
JOB_AGENT_LLM_BASE_URL=https://api.openai.com/v1
JOB_AGENT_LLM_MODEL=gpt-4o-mini
JOB_AGENT_LLM_FALLBACK_MODEL=
JOB_AGENT_LLM_DAILY_BUDGET_USD=2.00
JOB_AGENT_LLM_TEMPERATURE=0.2
JOB_AGENT_LLM_MAX_TOKENS=1600
JOB_AGENT_LLM_INPUT_COST_PER_MILLION_USD=0
JOB_AGENT_LLM_OUTPUT_COST_PER_MILLION_USD=0
# Used only when the corresponding provider is enabled in config.yaml.
JOB_AGENT_OPENAI_API_KEY=
JOB_AGENT_OPENROUTER_API_KEY=
# Database defaults to $JOB_HARNESS_HOME/state.sqlite3; normally do not override it.
JOB_AGENT_HEADLESS=true
JOB_AGENT_BROWSER_MIN_ACTION_DELAY_SECONDS=2.5
JOB_AGENT_BROWSER_MAX_ACTION_DELAY_SECONDS=5.0
